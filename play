#!/bin/sh

script_path=$0
while [ -L "$script_path" ]; do
    link_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
    script_path=$(readlink "$script_path")
    case "$script_path" in
        /*) ;;
        *) script_path="$link_dir/$script_path" ;;
    esac
done
project_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)

case "${1:-}" in
    install|update|uninstall)
        exec sh "$project_dir/install.sh" "$1"
        ;;
esac

exec python3 "$project_dir/solitaire.py" "$@"
